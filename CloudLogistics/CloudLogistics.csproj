<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AngryMonkey.CloudLogistics</AssemblyName>
    <RootNamespace>AngryMonkey.CloudLogistics</RootNamespace>
    <PackageId>AngryMonkey.CloudLogistics</PackageId>
    <Version>0.1.0</Version>
    <Authors>Angry Monkey</Authors>
    <Company>Angry Monkey</Company>
    <Product>Cloud Logistics</Product>
    <Description>Inventory, fulfillment, shipping, and delivery abstractions for .NET applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngryMonkey.CloudGeography" Version="2.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
