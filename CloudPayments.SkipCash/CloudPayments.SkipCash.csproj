    <RootNamespace>AngryMonkey.CloudPayments.SkipCash</RootNamespace>
    <PackageId>AngryMonkey.CloudPayments.SkipCash</PackageId>
    <Version>0.1.0</Version>
    <Authors>Angry Monkey</Authors>
