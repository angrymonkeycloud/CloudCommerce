<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AngryMonkey.CloudPayments.Stripe</AssemblyName>
    <RootNamespace>AngryMonkey.CloudPayments.Stripe</RootNamespace>
    <PackageId>AngryMonkey.CloudPayments.Stripe</PackageId>
    <Version>0.1.0</Version>
    <Authors>Angry Monkey</Authors>
    <Company>Angry Monkey</Company>
    <Description>Stripe provider adapter for AngryMonkey.CloudPayments.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Stripe.net" Version="53.2.0" />
    <ProjectReference Include="..\CloudPayments\CloudPayments.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
