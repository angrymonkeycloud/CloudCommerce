@inherits LayoutComponentBase
@inject IJSRuntime JS

<a class="demo-skip-link" href="#demo-main">Skip to demo</a>
<div class="demo-app @(_navigationOpen ? "_navigation-open" : null)" data-demo-theme="@_theme" data-commerce-theme="@_theme">
    <aside class="demo-sidebar">
        <DemoNav OnNavigate="() => _navigationOpen = false" />
        <div class="demo-sidebar-footer">
            <span class="demo-status-dot" aria-hidden="true"></span>
            <div><strong>Interactive demo ready</strong><small>Safe mode unless sandbox credentials are configured</small></div>
        </div>
    </aside>
    <div class="demo-shell">
        <header class="demo-topbar"><button class="demo-menu-toggle demo-button demo-button--ghost" type="button" aria-expanded="@(_navigationOpen ? "true" : "false")" aria-label="Toggle demo navigation" @onclick="() => _navigationOpen = !_navigationOpen">Demos</button>
            <div class="demo-mobile-brand"><span>AM</span><strong>CloudCommerce</strong></div>
            <div class="demo-topbar-context"><span>Developer workshop</span><strong>View · Code · Instructions</strong></div>
            <div class="demo-topbar-actions">
                <a href="https://github.com/angrymonkeycloud/CloudCommerce" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                <button type="button" class="demo-theme-toggle" @onclick="ToggleThemeAsync" aria-label="Use @(IsDark ? "light" : "dark") theme" aria-pressed="@(IsDark ? "true" : "false")" title="Use @(IsDark ? "light" : "dark") theme">
                    <span aria-hidden="true">@(IsDark ? "☀" : "◐")</span>
                </button>
            </div>
        </header>
        <main class="demo-main" id="demo-main"><DemoWorkspace>@Body</DemoWorkspace></main>
        <footer class="demo-footer"><span>Try every demo, copy its source, and follow its instructions in one workspace.</span><span>Payments · Logistics · Booking · Commerce</span></footer>
    </div>
</div>

@code {
    private bool _navigationOpen;
    private string _theme = "light";
    private bool IsDark => _theme == "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        string? storedTheme = await JS.InvokeAsync<string?>("cloudCommerceDemo.getTheme");
        if (storedTheme is "dark" or "light")
        {
            _theme = storedTheme;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _theme = IsDark ? "light" : "dark";
        await JS.InvokeVoidAsync("cloudCommerceDemo.setTheme", _theme);
    }
}
