@inherits LayoutComponentBase

<div class="demo-app" data-demo-theme="@(_dark ? "dark" : "light")" data-commerce-theme="@(_dark ? "dark" : "light")">
    <aside class="demo-sidebar">
        <DemoNav />
        <div class="demo-sidebar-footer">
            <span class="demo-status-dot" aria-hidden="true"></span>
            <div><strong>All systems ready</strong><small>Safe simulated mode</small></div>
        </div>
    </aside>
    <div class="demo-shell">
        <header class="demo-topbar">
            <div class="demo-mobile-brand"><span>AM</span><strong>CloudCommerce</strong></div>
            <div class="demo-topbar-context"><span>Angry Monkey Cloud</span><strong>Commerce ecosystem</strong></div>
            <div class="demo-topbar-actions">
                <a href="https://github.com/angrymonkeycloud" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                <button type="button" class="demo-theme-toggle" @onclick="ToggleTheme" aria-label="Toggle color theme"><span aria-hidden="true">@(_dark ? "☀" : "◐")</span></button>
            </div>
        </header>
        <main class="demo-main">@Body</main>
        <footer class="demo-footer"><span>Built with independent Angry Monkey Cloud domains.</span><span>Payments · Logistics · Booking · Commerce</span></footer>
    </div>
</div>

@code {
    private bool _dark;
    private void ToggleTheme() => _dark = !_dark;
}