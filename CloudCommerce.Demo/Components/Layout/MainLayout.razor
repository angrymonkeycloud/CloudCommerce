@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="demo-app" data-demo-theme="@_theme" data-commerce-theme="@_theme">
    <aside class="demo-sidebar">
        <DemoNav />
        <div class="demo-sidebar-footer">
            <span class="demo-status-dot" aria-hidden="true"></span>
            <div><strong>Interactive demo ready</strong><small>Safe mode unless sandbox credentials are configured</small></div>
        </div>
    </aside>
    <div class="demo-shell">
        <header class="demo-topbar">
            <div class="demo-mobile-brand"><span>AM</span><strong>CloudCommerce</strong></div>
            <div class="demo-topbar-context"><span>Developer showcase</span><strong>Reusable components and integration code</strong></div>
            <div class="demo-topbar-actions">
                <a href="https://github.com/angrymonkeycloud/CloudCommerce" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                <button type="button" class="demo-theme-toggle" @onclick="ToggleThemeAsync" aria-label="Use @(IsDark ? "light" : "dark") theme" aria-pressed="@IsDark" title="Use @(IsDark ? "light" : "dark") theme">
                    <span aria-hidden="true">@(IsDark ? "☀" : "◐")</span>
                </button>
            </div>
        </header>
        <main class="demo-main">@Body</main>
        <footer class="demo-footer"><span>Each preview identifies the reusable package component and shows its integration code.</span><span>Payments · Logistics · Booking · Commerce</span></footer>
    </div>
</div>

@code {
    private string _theme = "light";
    private bool IsDark => _theme == "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        string? storedTheme = await JS.InvokeAsync<string?>("cloudCommerceDemo.getTheme");
        if (storedTheme is "dark" or "light")
        {
            _theme = storedTheme;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _theme = IsDark ? "light" : "dark";
        await JS.InvokeVoidAsync("cloudCommerceDemo.setTheme", _theme);
    }
}