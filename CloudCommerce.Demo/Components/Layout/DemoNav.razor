<a class="demo-brand" href="/"><span class="demo-brand-mark" aria-hidden="true">AM</span><span><strong>CloudCommerce</strong><small>Developer workshop</small></span></a>
<label class="demo-nav-search"><span>Find a demo</span><input type="search" placeholder="Search demos…" @bind="_query" @bind:event="oninput" /></label>
<nav class="demo-nav" aria-label="Demo navigation" @onclick="() => OnNavigate.InvokeAsync()">
    <span class="demo-nav-label">Journeys</span>
    @foreach ((string Path, string Title) journey in Journeys.Where(item => Matches(item.Title)))
    {
        <NavLink href="@journey.Path" Match="NavLinkMatch.All"><span>@journey.Title</span></NavLink>
    }
    <span class="demo-nav-label">Payment labs</span>
    <div class="demo-nav-sublinks">
        @foreach (PaymentProviderLabDefinition provider in PaymentProviderLabCatalog.All.Where(item => Matches(item.DisplayName)))
        {
            <NavLink href="@($"/payments/{provider.Slug}")"><i></i><span>@provider.DisplayName</span></NavLink>
        }
    </div>
    <span class="demo-nav-label">Components · @ComponentReferenceCatalog.All.Count</span>
    <div class="demo-nav-sublinks">
        @foreach (ComponentReferenceDefinition component in ComponentReferenceCatalog.All.Where(item => Matches(item.Title + " " + item.Tag)))
        {
            <NavLink href="@($"/components/{component.Slug}")"><i></i><span>@component.Title</span></NavLink>
        }
    </div>
    @if (!Journeys.Any(item => Matches(item.Title)) && !PaymentProviderLabCatalog.All.Any(item => Matches(item.DisplayName)) && !ComponentReferenceCatalog.All.Any(item => Matches(item.Title + " " + item.Tag)))
    {
        <p role="status">No matching demos.</p>
    }
</nav>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    private string _query = string.Empty;
    private static readonly (string Path, string Title)[] Journeys = [("/", "Overview"), ("/storefront", "Storefront"), ("/payments", "Payment providers"), ("/booking", "Booking"), ("/logistics", "Logistics"), ("/components", "Component catalog"), ("/architecture", "Architecture")];
    private bool Matches(string value) => value.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase);
}
