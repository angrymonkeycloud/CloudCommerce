@page "/"
@inject IPaymentProviderRegistry PaymentProviders
@inject IShippingProviderRegistry ShippingProviders

<PageTitle>CloudCommerce developer ecosystem</PageTitle>

<section class="demo-hero">
    <div class="demo-hero-copy">
        <span class="demo-kicker"><i></i> Four independent domains. One composed journey.</span>
        <h1>Commerce infrastructure,<br /><em>designed to come apart.</em></h1>
        <p>Payments, logistics, booking, and commerce orchestration that work independently—then compose into a storefront without taking ownership of your product model.</p>
        <div class="demo-hero-actions"><a class="demo-button demo-button--primary" href="storefront">Experience the storefront <span>→</span></a><a class="demo-button demo-button--ghost" href="payments">Open real sandbox labs</a></div>
        <div class="demo-hero-trust"><span><b>✓</b> Headless-first</span><span><b>✓</b> Provider-neutral</span><span><b>✓</b> Replaceable UI</span></div>
    </div>
    <div class="demo-hero-visual" aria-label="CloudCommerce domain composition">
        <div class="demo-orbit demo-orbit--one"></div><div class="demo-orbit demo-orbit--two"></div>
        <div class="demo-domain-core"><span>CC</span><strong>CloudCommerce</strong><small>Orchestration</small></div>
        <a class="demo-domain-node demo-domain-node--payments" href="payments"><span>▣</span><strong>Payments</strong><small>@PaymentCount adapters</small></a>
        <a class="demo-domain-node demo-domain-node--logistics" href="logistics"><span>⇢</span><strong>Logistics</strong><small>@ShippingCount carriers</small></a>
        <a class="demo-domain-node demo-domain-node--booking" href="booking"><span>◷</span><strong>Booking</strong><small>Standalone</small></a>
    </div>
</section>

<section class="demo-portal-stats">
    <article><strong>7</strong><span>real payment sandbox labs</span><a href="payments">Choose provider →</a></article>
    <article><strong>12</strong><span>public component reference pages</span><a href="components">Browse components →</a></article>
    <article><strong>3</strong><span>carrier adapter workflows</span><a href="logistics">Open logistics →</a></article>
    <article><strong>1</strong><span>complete storefront journey</span><a href="storefront">Run storefront →</a></article>
</section>

<DemoExample Title="Register the ecosystem" Kind="Application startup" Description="Install only the domains your application needs. CloudCommerce is the optional composition layer; the specialized services remain independently usable." Code="@DemoCodeSamples.Composition" FileName="Program.cs">
    <div class="demo-composition-preview"><article><span>CloudPayments</span><strong>Provider-neutral transactions</strong></article><article><span>CloudLogistics</span><strong>Inventory and delivery</strong></article><article><span>CloudBooking</span><strong>Availability and reservations</strong></article><b>→</b><article class="primary"><span>CloudCommerce</span><strong>Optional checkout orchestration</strong></article></div>
</DemoExample>

<section class="demo-section">
    <DemoPageHeader Eyebrow="Developer portal" Title="Choose a complete journey, a real adapter lab, or one shipped component." Description="Package surfaces and demo-only test harnesses are labeled explicitly on every reference page." />
    <div class="demo-feature-grid">
        <a class="demo-feature-card demo-feature-card--store" href="storefront"><span class="demo-feature-icon">◇</span><div><small>Full composition</small><h2>Storefront journey</h2><p>Add to cart, apply discounts, reserve a booking, select shipping and payment, and complete checkout.</p></div><b>Open journey →</b></a>
        <a class="demo-feature-card" href="payments"><span class="demo-feature-icon">▣</span><div><small>Seven dedicated pages</small><h2>Real payment labs</h2><p>Configure your own test keys, call the real adapter sandbox, and open hosted checkout.</p></div><b>Choose provider →</b></a>
        <a class="demo-feature-card" href="components"><span class="demo-feature-icon">⌘</span><div><small>Twelve dedicated pages</small><h2>Component API catalog</h2><p>See what ships in NuGet, its namespace, source, parameters, events, live UI, and code.</p></div><b>Browse components →</b></a>
        <a class="demo-feature-card" href="booking"><span class="demo-feature-icon">◷</span><div><small>Time and capacity</small><h2>Booking studio</h2><p>Generate availability, reserve capacity, confirm, reschedule, cancel, and release capacity.</p></div><b>Explore booking →</b></a>
    </div>
</section>

<DemoCallout Tone="warning" Icon="!" Title="Safe storefront, real provider labs">The storefront uses a local safe driver. Dedicated payment labs send real provider sandbox requests only after you configure your own test credentials; every lab links to official setup and test-card resources.</DemoCallout>

@code {
    private int PaymentCount => Math.Max(7, PaymentProviders.Providers.Count(provider => provider.Name != "Demo"));
    private int ShippingCount => Math.Max(3, ShippingProviders.Providers.Count(provider => provider.Name != "Demo Shipping"));
}