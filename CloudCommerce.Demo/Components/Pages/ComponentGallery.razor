@page "/components"

<PageTitle>CloudCommerce component API catalog</PageTitle>

<DemoPageHeader Eyebrow="CloudCommerce.Components · Public API" Title="Every real component, separated from demo scaffolding." Description="Each card below links to a dedicated live reference page. The package, namespace, source file, parameters, events, integration code, and interactive behavior are shown explicitly.">
    <span class="demo-mode-badge"><i></i> @ComponentReferenceCatalog.All.Count shipped components</span>
</DemoPageHeader>

<div class="demo-boundary-banner">
    <div class="demo-boundary-item is-package"><span>YOU INSTALL THIS</span><strong>AngryMonkey.CloudCommerce.Components</strong><code>Reusable Razor Class Library</code></div>
    <div class="demo-boundary-arrow">vs</div>
    <div class="demo-boundary-item is-demo"><span>REFERENCE APP ONLY</span><strong>CloudCommerce.Demo</strong><code>Pages, fixtures, lab panels</code></div>
</div>

<DemoCallout Tone="success" Icon="✓" Title="The rule is now visible everywhere">Green “PACKAGE COMPONENT” labels identify UI shipped to developers. Amber “DEMO-ONLY HARNESS” labels identify documentation and test scaffolding that is not part of the package.</DemoCallout>

<section class="demo-component-catalog">
    @foreach (IGrouping<string, ComponentReferenceDefinition> group in ComponentReferenceCatalog.All.GroupBy(component => component.Category))
    {
        <section class="demo-component-group">
            <header><span>@group.Key</span><small>@group.Count() component@(group.Count() == 1 ? string.Empty : "s")</small></header>
            <div>
                @foreach (ComponentReferenceDefinition component in group)
                {
                    <a class="demo-component-api-card" href="@($"/components/{component.Slug}")">
                        <span class="demo-package-label">PACKAGE COMPONENT</span>
                        <code>&lt;@component.Tag /&gt;</code>
                        <h2>@component.Title</h2>
                        <p>@component.Description</p>
                        <footer><span>@component.Parameters.Count parameter@(component.Parameters.Count == 1 ? string.Empty : "s") · @component.Events.Count event@(component.Events.Count == 1 ? string.Empty : "s")</span><strong>Open live reference →</strong></footer>
                    </a>
                }
            </div>
        </section>
    }
</section>

<section class="demo-token-section">
    <DemoPageHeader Eyebrow="Theme contract" Title="Shared tokens support light and dark hosts." Description="Override CSS custom properties in application-owned LESS, or replace a semantic component slot when markup control is required." />
    <div class="demo-token-grid"><article><span style="--swatch:#6d4aff"></span><code>--commerce-primary</code><small>Brand actions</small></article><article><span style="--swatch:var(--commerce-surface)"></span><code>--commerce-surface</code><small>Cards and panels</small></article><article><span style="--swatch:var(--commerce-ink)"></span><code>--commerce-ink</code><small>Readable hierarchy</small></article><article><span style="--swatch:#00a884"></span><code>--commerce-success</code><small>Positive state</small></article></div>
</section>