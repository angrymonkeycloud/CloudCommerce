@page "/payments"
@inject SandboxPaymentRunner Runner

<PageTitle>CloudPayments sandbox provider labs</PageTitle>

<DemoPageHeader Eyebrow="CloudPayments" Title="Pick a payment provider." Description="Each one opens a lab where you paste test keys and run a real sandbox payment. Start with the built-in sandbox if you don't have keys yet.">
    <span class="demo-mode-badge"><i></i> @ConfiguredCount / @PaymentProviderLabCatalog.All.Count configured</span>
</DemoPageHeader>

<DemoCallout Tone="success" Icon="✓" Title="Start with no setup at all">The <a href="/payments/sandbox">built-in sandbox adapter</a> needs no keys and runs immediately. For a real gateway, paste your sandbox credentials straight into its lab page — they apply instantly, with no restart and no user-secrets. Never use live credentials here.</DemoCallout>

<section class="demo-provider-grid demo-provider-grid--labs">
    @foreach (PaymentProviderLabDefinition definition in PaymentProviderLabCatalog.All)
    {
        ProviderCardModel card = Card(definition);
        <ProviderCard Model="card" ActionHref="@($"/payments/{definition.Slug}")" ActionLabel="Open sandbox lab" />
    }
</section>

@code {
    private int ConfiguredCount => PaymentProviderLabCatalog.All.Count(IsConfigured);
    private bool IsConfigured(PaymentProviderLabDefinition definition) => Runner.IsConfigured(definition);

    private ProviderCardModel Card(PaymentProviderLabDefinition definition)
    {
        // Matched by name rather than position: the lab catalog also carries the keyless
        // sandbox adapter, which has no marketing card in DemoCatalog.
        ProviderCardModel? source = DemoCatalog.PaymentProviders
            .FirstOrDefault(provider => provider.Name.Equals(definition.DisplayName, StringComparison.OrdinalIgnoreCase)
                                     || provider.Name.Equals(definition.ProviderName, StringComparison.OrdinalIgnoreCase));

        if (source is null)
            return new(definition.DisplayName, "Built-in adapter", definition.CustomerExperience, definition.Region,
                ["Create", "Authorize", "Capture", "Refund", "Void"], definition.DocumentationUrl, definition.TestingUrl,
                definition.PortalUrl, IsConfigured: true, Accent: "green");

        return source with { Name = definition.DisplayName, IsConfigured = IsConfigured(definition) };
    }
}