@page "/components/{ComponentSlug}"

@if (Definition is null)
{
    <PageTitle>Component not found</PageTitle>
    <DemoPageHeader Title="Component not found" Description="Choose a component from the workshop navigation." />
}
else
{
    <PageTitle>@Definition.Title demo</PageTitle>
    <DemoPageHeader Eyebrow="@Definition.Category" Title="@Definition.Title" Description="@Definition.Description"><span class="demo-package-label">PACKAGE COMPONENT</span></DemoPageHeader>
    <p class="demo-source-note"><code>@ComponentReferenceCatalog.PackageName</code> · <code>&lt;@Definition.Tag /&gt;</code></p>
    <SectionContent SectionName="demo-configuration">
        <label>Product fixture<select @bind="_productIndex">@for (int i = 0; i < DemoCatalog.Products.Count; i++) { <option value="@i">@DemoCatalog.Products[i].Title</option> }</select></label>
        @if (Definition.Slug is "cart-view" or "cart-item-view" or "order-summary" or "checkout-view")
        {
            <label>Quantity<input type="number" min="1" max="10" @bind="_quantity" /></label>
        }
        @if (Definition.Slug is "cart-view" or "cart-item-view" or "payment-selector" or "shipping-selector" or "booking-selector" or "shipment-tracker")
        {
            <label class="demo-toggle"><input type="checkbox" @bind="_empty" /> Empty data</label>
        }
        @if (Definition.Slug is "checkout-progress" or "checkout-view")
        {
            <label>Active step<select @bind="_step"><option value="0">Cart</option><option value="1">Delivery</option><option value="2">Payment</option></select></label>
        }
        @if (Definition.Slug == "shipment-tracker")
        {
            <label>Shipment status<select @bind="_shipmentStatus">@foreach (ShipmentStatuses status in Enum.GetValues<ShipmentStatuses>()) { <option value="@status">@status</option> }</select></label>
        }
        @if (Definition.Slug == "commerce-component-host")
        {
            <label>Component slot<select @bind="_hostSlot"><option value="@CommerceComponentSlots.ProductCard">Product card</option><option value="@CommerceComponentSlots.OrderSummary">Order summary</option></select></label>
        }
        <button class="demo-button demo-button--ghost" type="button" @onclick="Reset">Reset demo</button>
        <p>Use Instructions for every parameter and callback. Code contains the working source and fixture data.</p>
    </SectionContent>
    <section class="demo-component-live-stage" aria-label="Live package component">
        @switch (Definition.Slug)
        {
            case "product-card": <ProductCard Product="Product" OnAdd="Added" /> break;
            case "product-information": <ProductInformation Product="Product" OnAdd="Added" /> break;
            case "cart-view": <CartView Cart="Cart" OnRemove="Removed" /> break;
            case "cart-item-view":
                @if (!_empty && !_removed) { <ul class="commerce-cart-items"><CartItemView Item="Item" OnRemove="Removed" /></ul> } else { <p>No cart rows. Reset to restore the fixture.</p> }
                break;
            case "coupon-input": <CouponInput OnApply="CouponApplied" /> break;
            case "payment-selector": <PaymentSelector Options="@(_empty ? [] : DemoCatalog.CheckoutPaymentOptions)" SelectedProvider="_payment" OnSelected="PaymentSelected" /> break;
            case "shipping-selector": <ShippingSelector Options="@(_empty ? [] : ShippingOptions)" Selected="_shipping" OnSelected="ShippingSelected" /> break;
            case "booking-selector": <BookingSelector Slots="@(_empty ? [] : _slots)" Selected="_slot" OnSelected="SlotSelected" TimeZoneLabel="UTC" /> break;
            case "shipment-tracker": <ShipmentTracker Shipment="Shipment" Events="@(_empty ? [] : TrackingEvents)" /> break;
            case "checkout-progress": <CheckoutProgress Steps="CheckoutSteps" /> break;
            case "order-summary": <OrderSummary Totals="Totals" /> break;
            case "search-filter": <SearchFilter Query="_query" QueryChanged="QueryChanged" /> break;
            case "provider-card": <ProviderCard Model="Provider" Selected="_providerSelected" OnSelected="ProviderSelected" ActionLabel="Select provider" /> break;
            case "checkout-view": <CheckoutView Cart="Cart" Totals="Totals" Steps="CheckoutSteps"><p>Application-owned checkout content goes here.</p></CheckoutView> break;
            case "commerce-component-host": <CommerceComponentHost Slot="_hostSlot" Parameters="HostParameters" /> break;
        }
    </section>
    <div class="demo-reference-label is-demo"><span>DEMO EVENT INSPECTOR</span><p>Callbacks below belong to this workshop application.</p></div>
    <div class="demo-interaction-console" aria-live="polite"><span>Last interaction</span><strong>@(_interaction ?? "Interact with the component or change its configuration.")</strong></div>
}

@code {
    [Parameter] public string? ComponentSlug { get; set; }
    private ComponentReferenceDefinition? Definition;
    private string? _loadedSlug;
    private string? _interaction;
    private int _productIndex;
    private int _quantity = 2;
    private int _step = 1;
    private bool _empty;
    private bool _removed;
    private bool _providerSelected;
    private string _payment = "MyFatoorah";
    private string? _query;
    private ShippingSelection? _shipping;
    private TimeSlot? _slot;
    private IReadOnlyList<TimeSlot> _slots = [];
    private ShipmentStatuses _shipmentStatus = ShipmentStatuses.InTransit;
    private CommerceComponentSlots _hostSlot = CommerceComponentSlots.ProductCard;
    private readonly Guid _itemId = Guid.NewGuid();
    private ProductPresentation Product => DemoCatalog.Products[Math.Clamp(_productIndex, 0, DemoCatalog.Products.Count - 1)];
    private CartItem Item => new() { Id = _itemId, Product = Product, Quantity = Math.Clamp(_quantity, 1, 10) };
    private Cart Cart => new() { Currency = "USD", Items = _empty || _removed ? [] : [Item] };
    private CommerceTotals Totals => new() { Items = new("USD", Subtotal), Discount = new("USD", 0), Shipping = new("USD", 5), Tax = new("USD", decimal.Round((Subtotal + 5) * .05m, 2)), Final = new("USD", Subtotal + 5 + decimal.Round((Subtotal + 5) * .05m, 2)) };
    private decimal Subtotal => Product.Price.Value * Math.Clamp(_quantity, 1, 10);
    private static readonly IReadOnlyList<ShippingSelection> ShippingOptions = [new("Aramex", "priority", new("USD", 14.80m), DemoCatalog.WarehouseId), new("DHL Express", "express", new("USD", 22.40m), DemoCatalog.WarehouseId)];
    private Shipment Shipment => new(Guid.Parse("64b84f36-468e-499b-874a-3ca259665333"), "Aramex", "priority", _shipmentStatus, "AMC-DOH-240816");
    private IReadOnlyList<ShipmentTrackingEvent> TrackingEvents => [new("Prepared", "Label generated.", IsComplete: _shipmentStatus >= ShipmentStatuses.LabelCreated), new("In transit", "Accepted by carrier.", IsComplete: _shipmentStatus >= ShipmentStatuses.InTransit), new("Delivered", "Received by customer.", IsComplete: _shipmentStatus == ShipmentStatuses.Delivered)];
    private IReadOnlyList<CheckoutStepModel> CheckoutSteps => [new("Cart", "Review items", _step > 0, _step == 0), new("Delivery", "Choose carrier", _step > 1, _step == 1), new("Payment", "Complete securely", false, _step == 2)];
    private static ProviderCardModel Provider => DemoCatalog.PaymentProviders[0] with { IsConfigured = false };
    private IDictionary<string, object> HostParameters => _hostSlot == CommerceComponentSlots.OrderSummary ? new Dictionary<string, object> { ["Totals"] = Totals } : new Dictionary<string, object> { ["Product"] = Product, ["OnAdd"] = EventCallback.Factory.Create<ProductPresentation>(this, Added) };

    protected override void OnParametersSet()
    {
        if (_loadedSlug == ComponentSlug)
            return;
        _loadedSlug = ComponentSlug;
        Definition = ComponentReferenceCatalog.Find(ComponentSlug);
        Reset();
    }

    private void Reset()
    {
        _productIndex = 0; _quantity = 2; _step = 1; _empty = false; _removed = false; _providerSelected = false; _payment = "MyFatoorah"; _query = null; _interaction = null;
        _shipmentStatus = ShipmentStatuses.InTransit; _hostSlot = CommerceComponentSlots.ProductCard; _shipping = ShippingOptions[0];
        DateTimeOffset start = new(DateTime.UtcNow.Date.AddDays(1).AddHours(10), TimeSpan.Zero);
        _slots = Enumerable.Range(0, 6).Select(index => new TimeSlot(DemoCatalog.ResourceId, start.AddHours(index * 2), start.AddHours(index * 2 + 1), 2)).ToArray();
        _slot = _slots[0];
    }

    private void Added(ProductPresentation product) => _interaction = $"OnAdd: {product.Id}";
    private void Removed(Guid id) { _removed = true; _interaction = $"OnRemove: {id:N}. Row removed."; }
    private void CouponApplied(string code) => _interaction = $"OnApply: {code}";
    private void PaymentSelected(string provider) { _payment = provider; _interaction = $"OnSelected: {provider}"; }
    private void ShippingSelected(ShippingSelection shipping) { _shipping = shipping; _interaction = $"OnSelected: {shipping.Provider}/{shipping.ServiceCode}"; }
    private void SlotSelected(TimeSlot slot) { _slot = slot; _interaction = $"OnSelected: {slot.StartsAt:O}"; }
    private void QueryChanged(string? query) { _query = query; _interaction = $"QueryChanged: {query}"; }
    private void ProviderSelected(ProviderCardModel provider) { _providerSelected = true; _interaction = $"OnSelected: {provider.Name}"; }
}
